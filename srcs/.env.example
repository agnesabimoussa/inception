# Copy this file to srcs/.env and fill in the values.
# Non-secret settings only: passwords go in ../secrets/*.txt

DOMAIN_NAME=aabi-mou.42.fr

# MYSQL SETUP
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
# DB_HOST, not MYSQL_HOST: the mariadb client reads MYSQL_HOST as its default server
DB_HOST=mariadb
MYSQL_PORT=3306

# WORDPRESS SETUP
WP_HOST=wordpress
WP_PORT=9000
WP_TITLE=Inception
# Must not contain "admin" or "administrator" (any case)
WP_ADMIN_USER=change_me
WP_ADMIN_EMAIL=change_me@example.com
WP_USER=change_me
WP_USER_EMAIL=change_me@example.com

# ADMINER SETUP (bonus)
ADMINER_HOST=adminer
ADMINER_PORT=9001

# REDIS SETUP (bonus)
REDIS_HOST=redis
REDIS_PORT=6379

# FTP SETUP (bonus)
FTP_USER=ftp_aabi
FTP_PORT=21
# Passive mode data ports, published like FTP_PORT
FTP_PASV_MIN=21100
FTP_PASV_MAX=21110
# Address clients use to reach the host (127.0.0.1 when testing on the VM itself)
FTP_PASV_ADDRESS=127.0.0.1

# STATIC SITE SETUP (bonus)
STATIC_HOST=static
STATIC_PORT=8080

# NGINX SETUP
NGINX_PORT=443

# HOST STORAGE (named volumes store their data here)
DATA_PATH=/home/aabi-mou/data
